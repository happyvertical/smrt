{
  "name": "@happyvertical/smrt-svelte",
  "version": "0.55.7",
  "smrtJsdoc": "strict",
  "description": "Svelte 5 components for SMRT user management - auth, users, tenants, roles, permissions, groups",
  "type": "module",
  "smrtRawPrimitives": "strict",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./forms": {
      "types": "./dist/components/forms/index.d.ts",
      "svelte": "./dist/components/forms/index.js",
      "import": "./dist/components/forms/index.js",
      "default": "./dist/components/forms/index.js"
    },
    "./settings": {
      "types": "./dist/components/settings/index.d.ts",
      "svelte": "./dist/components/settings/index.js",
      "import": "./dist/components/settings/index.js",
      "default": "./dist/components/settings/index.js"
    },
    "./screens": {
      "types": "./dist/components/screens/index.d.ts",
      "svelte": "./dist/components/screens/index.js",
      "import": "./dist/components/screens/index.js",
      "default": "./dist/components/screens/index.js"
    },
    "./board": {
      "types": "./dist/components/board/index.d.ts",
      "svelte": "./dist/components/board/index.js",
      "import": "./dist/components/board/index.js",
      "default": "./dist/components/board/index.js"
    },
    "./import-export": {
      "types": "./dist/components/import-export/index.d.ts",
      "svelte": "./dist/components/import-export/index.js",
      "import": "./dist/components/import-export/index.js",
      "default": "./dist/components/import-export/index.js"
    },
    "./command-palette": {
      "types": "./dist/components/command-palette/index.d.ts",
      "svelte": "./dist/components/command-palette/index.js",
      "import": "./dist/components/command-palette/index.js",
      "default": "./dist/components/command-palette/index.js"
    },
    "./sortable": {
      "types": "./dist/components/sortable/index.d.ts",
      "svelte": "./dist/components/sortable/index.js",
      "import": "./dist/components/sortable/index.js",
      "default": "./dist/components/sortable/index.js"
    },
    "./i18n/server": {
      "types": "./dist/i18n/server.d.ts",
      "import": "./dist/i18n/server.js",
      "default": "./dist/i18n/server.js"
    },
    "./workspace": {
      "types": "./dist/components/workspace/index.d.ts",
      "svelte": "./dist/components/workspace/index.js",
      "import": "./dist/components/workspace/index.js",
      "default": "./dist/components/workspace/index.js"
    },
    "./workspace/layout": {
      "types": "./dist/components/workspace/admin-shell/layout.d.ts",
      "import": "./dist/components/workspace/admin-shell/layout.js",
      "default": "./dist/components/workspace/admin-shell/layout.js"
    },
    "./workspace/legacy": {
      "types": "./dist/components/workspace/legacy.d.ts",
      "svelte": "./dist/components/workspace/legacy.js",
      "import": "./dist/components/workspace/legacy.js",
      "default": "./dist/components/workspace/legacy.js"
    },
    "./workspace/server": {
      "types": "./dist/components/workspace/server/index.d.ts",
      "import": "./dist/components/workspace/server/index.js",
      "default": "./dist/components/workspace/server/index.js"
    },
    "./app": {
      "types": "./dist/components/app/index.d.ts",
      "svelte": "./dist/components/app/index.js",
      "import": "./dist/components/app/index.js",
      "default": "./dist/components/app/index.js"
    },
    "./app/runtime-diagnostics": {
      "types": "./dist/components/app/runtime-diagnostics-webmcp.d.ts",
      "import": "./dist/components/app/runtime-diagnostics-webmcp.js",
      "default": "./dist/components/app/runtime-diagnostics-webmcp.js"
    },
    "./workspace/live": {
      "types": "./dist/components/workspace/live/index.d.ts",
      "svelte": "./dist/components/workspace/live/index.js",
      "import": "./dist/components/workspace/live/index.js",
      "default": "./dist/components/workspace/live/index.js"
    },
    "./browser-ai": {
      "types": "./dist/browser-ai/index.d.ts",
      "import": "./dist/browser-ai/index.js",
      "default": "./dist/browser-ai/index.js"
    },
    "./browser-ai/whisper-worker": {
      "types": "./dist/browser-ai/adapters/stt/local-speech.worker.d.ts",
      "import": "./dist/browser-ai/adapters/stt/local-speech.worker.js",
      "default": "./dist/browser-ai/adapters/stt/local-speech.worker.js"
    },
    "./browser-ai/speech-worker": {
      "types": "./dist/browser-ai/adapters/stt/local-speech.worker.d.ts",
      "import": "./dist/browser-ai/adapters/stt/local-speech.worker.js",
      "default": "./dist/browser-ai/adapters/stt/local-speech.worker.js"
    },
    "./browser-ai/svelte": {
      "types": "./dist/browser-ai/svelte/index.d.ts",
      "svelte": "./dist/browser-ai/svelte/index.js",
      "import": "./dist/browser-ai/svelte/index.js",
      "default": "./dist/browser-ai/svelte/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "svelte": "./dist/web/index.js",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./data-surface": {
      "types": "./dist/data-surface.d.ts",
      "svelte": "./dist/data-surface.js",
      "import": "./dist/data-surface.js",
      "default": "./dist/data-surface.js"
    },
    "./data": {
      "types": "./dist/data-surface.d.ts",
      "svelte": "./dist/data-surface.js",
      "import": "./dist/data-surface.js",
      "default": "./dist/data-surface.js"
    },
    "./mcp-apps": {
      "types": "./dist/mcp-apps/index.d.ts",
      "svelte": "./dist/mcp-apps/index.js",
      "import": "./dist/mcp-apps/index.js",
      "default": "./dist/mcp-apps/index.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md",
    "agents"
  ],
  "scripts": {
    "build": "svelte-package -i src --tsconfig tsconfig.svelte.json && node ../../scripts/prune-svelte-package-artifacts.js dist",
    "dev": "svelte-package -i src --watch",
    "check": "pnpm exec svelte-check --tsconfig ./tsconfig.svelte.json",
    "prepack": "node ../../scripts/prepack-package.js",
    "test": "pnpm run test:unit && pnpm run test:conformance",
    "test:unit": "vitest run --exclude src/web/__tests__/data-surface-conformance.integration.svelte.test.ts && node --test scripts/*.test.mjs",
    "test:conformance": "node scripts/ensure-conformance-build.mjs && SMRT_SVELTE_PUBLISHED_ENTRY=1 vitest run src/web/__tests__/data-surface-conformance.integration.svelte.test.ts",
    "typecheck:conformance": "tsc --noEmit -p ./tsconfig.conformance.json",
    "typecheck": "tsc --noEmit && pnpm run typecheck:conformance && node ../../scripts/svelte-check-a11y.mjs --tsconfig ./tsconfig.svelte.json",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js .",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "keywords": [
    "smrt",
    "svelte",
    "svelte5",
    "components",
    "users",
    "tenants",
    "roles",
    "permissions",
    "auth"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/smrt-svelte"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-languages": "workspace:*",
    "@happyvertical/smrt-mcp-apps": "workspace:*",
    "@happyvertical/smrt-types": "workspace:*",
    "@happyvertical/smrt-ui": "workspace:*",
    "@happyvertical/smrt-web": "workspace:*",
    "@tanstack/db": "^0.6.14",
    "@tanstack/svelte-db": "^0.1.91",
    "esm-env": "^1.2.2"
  },
  "peerDependencies": {
    "@happyvertical/speech": ">=0.102.5",
    "@huggingface/transformers": ">=4.3.0",
    "@mlc-ai/web-llm": ">=0.2.85",
    "@remotion/whisper-web": ">=4.0.526",
    "bitgpu": "^0.19.1",
    "chrono-node": "^2.10.1",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "@happyvertical/speech": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "@mlc-ai/web-llm": {
      "optional": true
    },
    "@remotion/whisper-web": {
      "optional": true
    },
    "bitgpu": {
      "optional": true
    },
    "chrono-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happyvertical/smrt-agents": "workspace:*",
    "@happyvertical/smrt-chat": "workspace:*",
    "@happyvertical/smrt-content": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-reports": "workspace:*",
    "@happyvertical/smrt-scanner": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/smrt-users": "workspace:*",
    "@happyvertical/speech": "catalog:",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.13.6",
    "axe-core": "^4.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
