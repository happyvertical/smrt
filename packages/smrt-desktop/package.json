{
  "name": "@happyvertical/smrt-desktop",
  "version": "0.61.0",
  "description": "Versioned sidecar manifest, the runtime bundler and the assistant-plugin launcher for SMRT desktop apps",
  "author": "HappyVertical",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "CLAUDE.md",
    "dist",
    "AGENTS.md",
    "examples/*.json",
    "wrapper/Cargo.toml",
    "wrapper/Cargo.lock",
    "wrapper/build.rs",
    "wrapper/tauri.conf.json",
    "wrapper/capabilities",
    "wrapper/frontend",
    "wrapper/icons",
    "wrapper/src",
    "wrapper/scripts/launch-smoke.mjs",
    "wrapper/scripts/smoke-support.mjs",
    "wrapper/scripts/release-preflight.mjs",
    "wrapper/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundler": {
      "types": "./dist/bundler.d.ts",
      "import": "./dist/bundler.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "npm run build:watch & npm run test:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js .",
    "build:fresh": "npm run clean && npm run build && npm run verify:pack",
    "prepack": "node ../../scripts/prepack-package.js"
  },
  "dependencies": {
    "@happyvertical/smrt-app-runtime": "workspace:*"
  },
  "devDependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/smrt-desktop"
  }
}
