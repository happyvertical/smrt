SMRT_RUNTIME_PROFILE=self-hosted
DATABASE_URL=postgresql://smrt_app:change-me@database:5432/smrt_app
HOST=0.0.0.0
PORT=3000
# Provider adapters keep real credentials private. These readiness selectors
# only confirm the operator has wired each required provider.
SMRT_AUTH_READY=1
SMRT_ASSETS_READY=1
SMRT_SECRETS_READY=1
SMRT_WORKER_CONCURRENCY=4
