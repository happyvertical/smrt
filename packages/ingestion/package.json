{
  "name": "@happyvertical/smrt-ingestion",
  "version": "0.55.8",
  "description": "Durable tenant-scoped intake and evidence foundations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "agents",
    "AGENTS.md",
    "CLAUDE.md",
    "EXTRACTION.md",
    "PROPOSALS.md",
    "REVIEW.md",
    "FEEDBACK.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dto": {
      "types": "./dist/dto.d.ts",
      "import": "./dist/dto.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json",
    "./execution": {
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js"
    },
    "./proposals": {
      "types": "./dist/proposals.d.ts",
      "import": "./dist/proposals.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "scripts": {
    "build": "vite build --mode library && node scripts/check-browser.mjs && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json && node ../../scripts/prune-svelte-package-artifacts.js dist",
    "test": "vitest run && pnpm test:components",
    "test:postgres": "node ../../scripts/run-with-ci-postgres.mjs -- pnpm exec vitest run --config vitest.postgres.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && node ../../scripts/svelte-check-a11y.mjs --tsconfig ./tsconfig.svelte.json",
    "prepack": "node ../../scripts/prepack-package.js",
    "test:providers": "vitest run src/extraction.providers.test.ts src/proposals.providers.test.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:e2e": "playwright test -c e2e/review/playwright.config.ts",
    "test:evaluation": "vitest run --config evaluation/vitest.config.ts"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-types": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/smrt-assets": "workspace:*",
    "@happyvertical/smrt-jobs": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@happyvertical/pdf": "catalog:",
    "@happyvertical/ocr": "catalog:",
    "@happyvertical/speech": "catalog:",
    "@happyvertical/ai": "catalog:",
    "sharp": "catalog:",
    "@happyvertical/smrt-agents": "workspace:*",
    "@happyvertical/smrt-playbooks": "workspace:*",
    "ajv": "8.20.0",
    "@happyvertical/smrt-ui": "workspace:*"
  },
  "devDependencies": {
    "@happyvertical/smrt-vitest": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "@happyvertical/smrt-content": "workspace:*",
    "@happyvertical/smrt-messages": "workspace:*",
    "@happyvertical/email": "catalog:",
    "@happyvertical/smrt-users": "workspace:*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^29.1.1",
    "@playwright/test": "^1.63.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "author": "HappyVertical",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/ingestion"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
