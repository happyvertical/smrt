{
  "$schema": "https://s-m-r-t.dev/schemas/cookbook/v1.json",
  "version": 1,
  "theme": {
    "preset": "smrt"
  },
  "recipes": [
    "commerce.customers",
    "commerce.estimates",
    "commerce.invoicing",
    "commerce.purchases",
    "commerce.sales",
    "commerce.vendors",
    "events.calendar",
    "inventory.stock",
    "ledgers.bookkeeping",
    "products.simple"
  ],
  "features": [],
  "policies": [
    {
      "objectRef": "@happyvertical/smrt-commerce:ContractLineItem",
      "fieldName": "taxRate",
      "scopeType": "app",
      "defaultValue": "0.0825"
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Customer",
      "fieldName": "creditLimit",
      "scopeType": "app",
      "visibility": "hidden"
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Customer",
      "fieldName": "customerType",
      "scopeType": "app",
      "visibility": "hidden"
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Customer",
      "fieldName": "paymentTerms",
      "scopeType": "app",
      "defaultValue": "\"Due on receipt\""
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Estimate",
      "fieldName": "terms",
      "scopeType": "app",
      "defaultValue": "\"Due on receipt\""
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Invoice",
      "fieldName": "currency",
      "scopeType": "app",
      "defaultValue": "\"USD\""
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Invoice",
      "fieldName": "terms",
      "scopeType": "app",
      "defaultValue": "\"Due on receipt\""
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:InvoiceLineItem",
      "fieldName": "taxRate",
      "scopeType": "app",
      "defaultValue": "0.0825"
    },
    {
      "objectRef": "@happyvertical/smrt-commerce:Order",
      "fieldName": "terms",
      "scopeType": "app",
      "defaultValue": "\"Due on receipt\""
    }
  ],
  "layout": {
    "version": 1,
    "sectionOrder": [
      "custom:jobs",
      "custom:parts",
      "custom:billing",
      "custom:schedule",
      "section:accounting"
    ],
    "itemOrder": {
      "custom:jobs": [
        "item:commerce:Estimate",
        "item:commerce:Order",
        "item:commerce:Customer"
      ],
      "custom:parts": [
        "item:products:Product",
        "item:inventory:StockLevel",
        "item:commerce:Vendor",
        "item:commerce:PurchaseOrder"
      ],
      "custom:billing": [
        "item:commerce:Invoice",
        "item:commerce:Payment"
      ],
      "custom:schedule": [
        "item:events:Event",
        "item:events:EventType"
      ]
    },
    "hidden": [
      "item:events:EventSeries",
      "item:inventory:InventoryLocation",
      "item:inventory:StockMovement"
    ],
    "moved": {
      "item:commerce:Estimate": "custom:jobs",
      "item:commerce:Order": "custom:jobs",
      "item:commerce:Customer": "custom:jobs",
      "item:products:Product": "custom:parts",
      "item:inventory:StockLevel": "custom:parts",
      "item:commerce:Vendor": "custom:parts",
      "item:commerce:PurchaseOrder": "custom:parts",
      "item:commerce:Invoice": "custom:billing",
      "item:commerce:Payment": "custom:billing",
      "item:events:Event": "custom:schedule",
      "item:events:EventType": "custom:schedule"
    },
    "customSections": [
      {
        "id": "custom:jobs",
        "label": "Jobs"
      },
      {
        "id": "custom:parts",
        "label": "Parts"
      },
      {
        "id": "custom:billing",
        "label": "Billing"
      },
      {
        "id": "custom:schedule",
        "label": "Schedule"
      }
    ],
    "items": {
      "item:commerce:Estimate": {
        "label": "Quotes",
        "description": "Quotes for repairs, ready to become work orders once approved."
      },
      "item:commerce:Order": {
        "label": "Work orders",
        "description": "Every job in the shop, from drop-off to pick-up."
      },
      "item:products:Product": {
        "label": "Parts",
        "description": "The parts you sell and fit, with prices."
      },
      "item:inventory:StockLevel": {
        "label": "Parts on hand",
        "description": "Parts on the shelf, so you know what to reorder."
      },
      "item:commerce:Vendor": {
        "label": "Suppliers",
        "description": "The parts suppliers you buy from, with terms and contacts."
      },
      "item:commerce:PurchaseOrder": {
        "label": "Parts orders",
        "description": "Parts you have ordered and when they arrive."
      },
      "item:events:Event": {
        "label": "Appointments",
        "description": "Bookings on the shop calendar, by day and bay."
      },
      "item:events:EventType": {
        "label": "Appointment types",
        "description": "The kinds of service you book, like an oil change or inspection."
      }
    },
    "sections": {
      "custom:jobs": {
        "icon": "wrench"
      },
      "custom:parts": {
        "icon": "package"
      },
      "custom:billing": {
        "icon": "receipt"
      },
      "custom:schedule": {
        "icon": "calendar"
      }
    }
  }
}
