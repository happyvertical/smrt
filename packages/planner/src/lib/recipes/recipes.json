{
  "recipes": [
    {
      "id": "commerce.customers",
      "label": "Customers",
      "summary": "Keep a list of the people and companies you sell to.",
      "synonyms": [
        "clients",
        "buyers",
        "accounts"
      ],
      "models": [
        "@happyvertical/smrt-commerce:Customer"
      ],
      "nav": [
        {
          "label": "Customers",
          "model": "@happyvertical/smrt-commerce:Customer"
        }
      ],
      "requires": [],
      "forms": [
        {
          "id": "customer.default",
          "kind": "field-map",
          "label": "Customer",
          "kindLabel": "Customer",
          "model": "@happyvertical/smrt-commerce:Customer",
          "records": [
            {
              "as": "profileType",
              "model": "@happyvertical/smrt-profiles:ProfileType",
              "match": {
                "name": "Customer"
              }
            },
            {
              "as": "profile",
              "model": "@happyvertical/smrt-profiles:Profile",
              "match": {
                "id": {
                  "ref": "customer",
                  "field": "profileId"
                }
              },
              "values": {
                "typeId": {
                  "ref": "profileType"
                }
              }
            },
            {
              "as": "customer",
              "model": "@happyvertical/smrt-commerce:Customer",
              "values": {
                "profileId": {
                  "ref": "profile"
                }
              }
            }
          ],
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "to": "profile.name",
              "required": true
            },
            {
              "id": "email",
              "label": "Email",
              "to": "profile.email"
            },
            {
              "id": "status",
              "label": "Status",
              "to": "customer.status",
              "default": "active"
            },
            {
              "id": "customerType",
              "label": "Customer type",
              "to": "customer.customerType",
              "default": "dtc"
            },
            {
              "id": "paymentTerms",
              "label": "Payment terms",
              "to": "customer.paymentTerms"
            },
            {
              "id": "creditLimit",
              "label": "Credit limit",
              "to": "customer.creditLimit"
            },
            {
              "id": "taxExempt",
              "label": "Tax exempt",
              "to": "customer.taxExempt"
            },
            {
              "id": "taxId",
              "label": "Tax ID",
              "to": "customer.taxId"
            },
            {
              "id": "shippingAddress",
              "label": "Shipping address",
              "to": "customer.defaultShippingAddress"
            },
            {
              "id": "billingAddress",
              "label": "Billing address",
              "to": "customer.defaultBillingAddress"
            },
            {
              "id": "notes",
              "label": "Notes",
              "to": "customer.notes"
            }
          ]
        }
      ],
      "options": {
        "@happyvertical/smrt-commerce:Customer": {
          "fields": {
            "profileId": {
              "label": "Name",
              "order": -1
            }
          }
        }
      }
    },
    {
      "id": "commerce.purchases",
      "label": "Purchases",
      "summary": "Order from your vendors and track what you have bought.",
      "synonyms": [
        "purchase orders",
        "buying",
        "procurement"
      ],
      "models": [
        "@happyvertical/smrt-commerce:PurchaseOrder"
      ],
      "nav": [
        {
          "label": "Purchase Orders",
          "model": "@happyvertical/smrt-commerce:PurchaseOrder"
        }
      ],
      "requires": [
        "commerce.vendors"
      ],
      "options": {
        "@happyvertical/smrt-commerce:PurchaseOrder": {
          "fields": {
            "contractType": {
              "default": "purchase_order",
              "visibility": "hidden",
              "locked": true
            },
            "customerId": {
              "visibility": "hidden",
              "locked": true
            },
            "vendorId": {
              "label": "Vendor",
              "order": 1
            }
          }
        }
      }
    },
    {
      "id": "commerce.sales",
      "label": "Sales",
      "summary": "Take customer orders and track them.",
      "synonyms": [
        "sales orders",
        "orders",
        "customer orders"
      ],
      "models": [
        "@happyvertical/smrt-commerce:Order"
      ],
      "nav": [
        {
          "label": "Sales Orders",
          "model": "@happyvertical/smrt-commerce:Order"
        }
      ],
      "requires": [
        "commerce.customers"
      ],
      "options": {
        "@happyvertical/smrt-commerce:Order": {
          "fields": {
            "contractType": {
              "default": "order",
              "visibility": "hidden",
              "locked": true
            },
            "vendorId": {
              "visibility": "hidden",
              "locked": true
            },
            "customerId": {
              "label": "Customer",
              "order": 1
            }
          }
        }
      }
    },
    {
      "id": "commerce.vendors",
      "label": "Vendors",
      "summary": "Keep a list of the suppliers you buy from.",
      "synonyms": [
        "suppliers",
        "sellers"
      ],
      "models": [
        "@happyvertical/smrt-commerce:Vendor"
      ],
      "nav": [
        {
          "label": "Vendors",
          "model": "@happyvertical/smrt-commerce:Vendor"
        }
      ],
      "requires": [],
      "forms": [
        {
          "id": "vendor.default",
          "kind": "field-map",
          "label": "Vendor",
          "kindLabel": "Vendor",
          "model": "@happyvertical/smrt-commerce:Vendor",
          "records": [
            {
              "as": "profileType",
              "model": "@happyvertical/smrt-profiles:ProfileType",
              "match": {
                "name": "Vendor"
              }
            },
            {
              "as": "profile",
              "model": "@happyvertical/smrt-profiles:Profile",
              "match": {
                "id": {
                  "ref": "vendor",
                  "field": "profileId"
                }
              },
              "values": {
                "typeId": {
                  "ref": "profileType"
                }
              }
            },
            {
              "as": "vendor",
              "model": "@happyvertical/smrt-commerce:Vendor",
              "values": {
                "profileId": {
                  "ref": "profile"
                }
              }
            }
          ],
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "to": "profile.name",
              "required": true
            },
            {
              "id": "email",
              "label": "Email",
              "to": "profile.email"
            },
            {
              "id": "status",
              "label": "Status",
              "to": "vendor.status",
              "default": "active"
            },
            {
              "id": "currency",
              "label": "Currency",
              "to": "vendor.currency",
              "default": "USD"
            },
            {
              "id": "paymentTerms",
              "label": "Payment terms",
              "to": "vendor.paymentTerms"
            },
            {
              "id": "leadTimeDays",
              "label": "Lead time (days)",
              "to": "vendor.leadTimeDays"
            },
            {
              "id": "minimumOrderAmount",
              "label": "Minimum order",
              "to": "vendor.minimumOrderAmount"
            },
            {
              "id": "contactEmail",
              "label": "Contact email",
              "to": "vendor.defaultContactEmail"
            },
            {
              "id": "contactPhone",
              "label": "Contact phone",
              "to": "vendor.defaultContactPhone"
            },
            {
              "id": "notes",
              "label": "Notes",
              "to": "vendor.notes"
            },
            {
              "id": "payoutAddresses",
              "label": "Payout addresses",
              "to": "vendor.payoutAddresses"
            }
          ]
        }
      ],
      "options": {
        "@happyvertical/smrt-commerce:Vendor": {
          "fields": {
            "profileId": {
              "label": "Name",
              "order": -1
            }
          }
        }
      }
    },
    {
      "id": "inventory.stock",
      "label": "Inventory",
      "summary": "Keep count of how many of each product you have.",
      "synonyms": [
        "stock",
        "quantity",
        "on hand"
      ],
      "models": [
        "@happyvertical/smrt-inventory:StockLevel",
        "@happyvertical/smrt-inventory:InventoryLocation"
      ],
      "nav": [
        {
          "label": "Stock levels",
          "model": "@happyvertical/smrt-inventory:StockLevel"
        },
        {
          "label": "Locations",
          "model": "@happyvertical/smrt-inventory:InventoryLocation"
        }
      ],
      "requires": [],
      "requiresAny": [
        [
          "products.simple",
          "products.clothing"
        ]
      ],
      "extends": [
        {
          "form": "product.simple",
          "records": [
            {
              "as": "sku",
              "model": "@happyvertical/smrt-products:Sku",
              "match": {
                "productId": {
                  "ref": "product"
                }
              },
              "values": {
                "code": "{product.name|slug}",
                "name": "{product.name}",
                "attributes": "{}",
                "active": true
              }
            },
            {
              "as": "location",
              "model": "@happyvertical/smrt-inventory:InventoryLocation",
              "match": {
                "code": "MAIN"
              },
              "values": {
                "name": "Main warehouse",
                "kind": "warehouse"
              }
            },
            {
              "as": "stock",
              "model": "@happyvertical/smrt-inventory:StockLevel",
              "match": {
                "skuId": {
                  "ref": "sku"
                },
                "locationId": {
                  "ref": "location"
                },
                "state": "available"
              }
            }
          ],
          "fields": [
            {
              "id": "quantity",
              "label": "Quantity",
              "to": "stock.qty",
              "default": 0
            }
          ]
        },
        {
          "form": "product.clothing",
          "records": [
            {
              "as": "location",
              "model": "@happyvertical/smrt-inventory:InventoryLocation",
              "match": {
                "code": "MAIN"
              },
              "values": {
                "name": "Main warehouse",
                "kind": "warehouse"
              }
            },
            {
              "as": "stock",
              "model": "@happyvertical/smrt-inventory:StockLevel",
              "match": {
                "skuId": {
                  "ref": "sku"
                },
                "locationId": {
                  "ref": "location"
                },
                "state": "available"
              }
            }
          ],
          "fields": [
            {
              "id": "quantity",
              "label": "Quantity",
              "to": "stock.qty",
              "default": 0
            }
          ]
        }
      ],
      "options": {
        "@happyvertical/smrt-inventory:StockLevel": {
          "fields": {
            "reorderPoint": {
              "visibility": "hidden"
            },
            "reorderQuantity": {
              "visibility": "hidden"
            }
          }
        },
        "@happyvertical/smrt-inventory:InventoryLocation": {
          "fields": {
            "placeId": {
              "visibility": "hidden"
            },
            "active": {
              "visibility": "hidden"
            }
          }
        }
      }
    },
    {
