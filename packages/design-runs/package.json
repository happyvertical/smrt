{
  "name": "@happyvertical/smrt-design-runs",
  "version": "0.60.18",
  "description": "Durable inference design runs composed with background jobs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@happyvertical/smrt-inference": "workspace:*",
    "@happyvertical/smrt-jobs": "workspace:*",
    "@happyvertical/sql": "catalog:"
  },
  "devDependencies": {
    "@happyvertical/smrt-vitest": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "vitest": "4.1.10",
    "@happyvertical/smrt-core": "workspace:*",
    "ajv": "^8.20.0"
  },
  "keywords": [
    "smrt",
    "design",
    "jobs",
    "inference"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/design-runs"
  },
  "sideEffects": false
}
