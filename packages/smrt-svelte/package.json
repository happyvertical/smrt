{
  "name": "@happyvertical/smrt-svelte",
  "version": "0.17.85",
  "description": "Svelte 5 components for SMRT user management - auth, users, tenants, roles, permissions, groups",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src",
    "dev": "svelte-package -i src --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npx vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "smrt",
    "svelte",
    "svelte5",
    "components",
    "users",
    "tenants",
    "roles",
    "permissions",
    "auth"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/smrt-svelte"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/smrt-profiles": "workspace:*",
    "@happyvertical/smrt-users": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.18.2"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "svelte": "^5.18.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
