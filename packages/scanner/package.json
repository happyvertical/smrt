{
  "name": "@happyvertical/smrt-scanner",
  "version": "0.19.58",
  "description": "High-performance TypeScript scanner using OXC for SMRT manifest generation",
  "author": "Will Griffin <willgriffin@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smrt-scan": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./types": "./dist/types.js"
  },
  "dependencies": {
    "fast-glob": "3.3.3",
    "minimatch": "10.1.1",
    "oxc-parser": "^0.108.0",
    "oxc-resolver": "^11.16.3"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "tsx": "^4.21.0",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@happyvertical/smrt-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@happyvertical/smrt-core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
