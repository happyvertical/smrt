{
  "name": "@happyvertical/smrt-profiles",
  "version": "0.14.5",
  "description": "Profile management system with relationships, metadata, and reciprocal associations for SMRT framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./manifest": "./dist/manifest.json"
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "pretest": "[ -f ../cli/dist/index.js ] && node ../cli/dist/index.js test --manifest-only || true",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "^0.55.0",
    "@happyvertical/files": "^0.55.0",
    "@happyvertical/logger": "^0.55.0",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "^0.55.0",
    "@happyvertical/utils": "^0.55.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@happyvertical/smrt-cli": "workspace:*",
    "@types/node": "^24.0.0",
    "fast-glob": "3.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ai",
    "agents",
    "profiles",
    "relationships",
    "metadata",
    "smrt"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
