{
  "name": "@happyvertical/smrt-config",
  "version": "0.55.7",
  "type": "module",
  "description": "Centralized configuration management for SMRT modules",
  "author": "HappyVertical",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@happyvertical/smrt-types": "workspace:*",
    "cosmiconfig": "^10.0.1",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "keywords": [
    "config",
    "configuration",
    "smrt",
    "settings"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/config"
  }
}
