{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/engine",
    "rootDir": "src/engine",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "experimentalDecorators": true,
    "types": ["node"]
  },
  "include": ["src/engine/**/*.ts"],
  "exclude": ["src/engine/**/*.test.ts"]
}
