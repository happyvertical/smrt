{
  "name": "smrt-sveltekit-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "10.34.4"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate": "vite build && smrt db:migrate"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "@happyvertical/smrt-cli": "^0.40.57"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "^0.40.57",
    "@happyvertical/smrt-profiles": "^0.40.57",
    "@happyvertical/smrt-svelte": "^0.40.57",
    "@happyvertical/smrt-tenancy": "^0.40.57",
    "@happyvertical/smrt-ui": "^0.40.57",
    "@happyvertical/smrt-users": "^0.40.57"
  }
}
