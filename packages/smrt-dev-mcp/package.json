{
  "name": "@happyvertical/smrt-dev-mcp",
  "version": "0.25.21",
  "description": "Development MCP server for SMRT framework - Code generation and project introspection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "smrt-dev-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CLAUDE.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/smrt-dev-mcp"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/smrt/issues"
  },
  "homepage": "https://github.com/happyvertical/smrt/tree/main/packages/smrt-dev-mcp#readme",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "clean": "rm -rf dist",
    "dev": "npm run build:watch & npm run test:watch",
    "prepack": "node ../../scripts/prepack-package.js",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js ."
  },
  "dependencies": {
    "@happyvertical/ai": "catalog:",
    "@happyvertical/files": "catalog:",
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@happyvertical/utils": "catalog:",
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.17"
  },
  "author": "HappyVertical"
}
