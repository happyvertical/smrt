    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "status": {
              "const": 503
            },
            "body": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9 ._-]{1,120}$"
            }
          },
          "required": [
            "path",
            "status",
            "body"
          ]
        }
      },
      "required": [
