{
  "name": "@happyvertical/smrt-tenancy",
  "version": "0.19.28",
  "description": "Production-ready multi-tenancy framework for SMRT with automatic tenant isolation and enforcement",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "^0.66.9",
    "@happyvertical/utils": "^0.66.9"
  },
  "devDependencies": {
    "@happyvertical/smrt-vitest": "workspace:*",
    "@types/node": "25.0.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@happyvertical/smrt-users": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@happyvertical/smrt-users": {
      "optional": true
    }
  },
  "keywords": [
    "ai",
    "agents",
    "multi-tenancy",
    "tenancy",
    "isolation",
    "smrt"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
