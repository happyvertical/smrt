{
  "name": "@happyvertical/smrt-vitest",
  "version": "0.37.6",
  "description": "Vitest plugin for automatic cross-package manifest loading in SMRT tests",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    },
    "./svelte-setup": {
      "types": "./dist/svelte-setup.d.ts",
      "import": "./dist/svelte-setup.js",
      "default": "./dist/svelte-setup.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js",
      "default": "./dist/a11y.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "smrt",
    "vitest",
    "plugin",
    "testing",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/vitest"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.4"
  },
  "peerDependencies": {
    "svelte": ">=5.56.4",
    "vitest": ">=2.1.9"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "svelte": "^5.56.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "author": "HappyVertical"
}
