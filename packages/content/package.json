{
  "name": "@happyvertical/smrt-content",
  "version": "0.17.17",
  "description": "Content processing module for SMRT framework - handles documents, web content, and media",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": "./dist/manifest.json"
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "0.57.0",
    "@happyvertical/documents": "0.57.0",
    "@happyvertical/files": "0.57.0",
    "@happyvertical/logger": "0.57.0",
    "@happyvertical/ocr": "0.57.0",
    "@happyvertical/pdf": "0.57.0",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/spider": "0.57.0",
    "@happyvertical/sql": "0.57.0",
    "@happyvertical/utils": "0.57.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.2",
    "@types/node": "^24.0.0",
    "svelte": "^5.18.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ai",
    "agents",
    "content",
    "documents",
    "pdf",
    "web-scraping"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
