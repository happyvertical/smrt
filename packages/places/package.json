{
  "name": "@happyvertical/smrt-places",
  "version": "0.17.82",
  "description": "Hierarchical place management with geo integration and SMRT framework support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./manifest": "./dist/manifest.json"
  },
  "scripts": {
    "generate:test": "node scripts/generate-test-manifest.js",
    "build": "vite build --mode library && node ../../scripts/generate-stub-from-manifest.js",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "^0.60.9",
    "@happyvertical/cache": "^0.60.5",
    "@happyvertical/files": "^0.60.9",
    "@happyvertical/geo": "^0.60.5",
    "@happyvertical/logger": "^0.60.9",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "^0.60.9",
    "@happyvertical/utils": "^0.60.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-glob": "3.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ai",
    "agents",
    "places",
    "locations",
    "geocoding",
    "geography",
    "hierarchy",
    "smrt"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
