{
  "name": "@happyvertical/smrt-approvals",
  "version": "0.55.9",
  "description": "Approval decision gate for the SMRT framework: revision-bound, single-use approvals with quorum, expiry, and an append-only event ledger",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md",
    "agents"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite build --mode library --watch",
    "prepack": "node ../../scripts/prepack-package.js",
    "test": "vitest run",
    "test:postgres": "node ../../scripts/run-with-ci-postgres.mjs -- pnpm exec vitest run optional.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js ."
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/smrt-users": "workspace:*",
    "@happyvertical/sql": "catalog:"
  },
  "devDependencies": {
    "@happyvertical/smrt-vitest": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "smrtJsdoc": "strict",
  "smrtRawPrimitives": "strict",
  "keywords": [
    "smrt",
    "approvals",
    "workflow",
    "quorum",
    "audit",
    "multi-tenant"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/approvals"
  }
}
