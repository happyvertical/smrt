{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMRT Desktop",
  "version": "0.1.0",
  "identifier": "com.happyvertical.smrt-desktop-shell",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SMRT Desktop",
        "width": 1280,
        "height": 860,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
