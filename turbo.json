{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "tsconfig*.json",
    "vite.config.base.ts",
    "vitest.workspace.ts",
    "biome.json"
  ],
  "globalPassThroughEnv": [
    "PUBLISH_PACK_OUTPUT_DIR",
    "TMPDIR"
  ],
  "tasks": {
    "generate": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        "!src/**/__tests__/**",
        "!src/manifest/static-manifest.ts",
        "!src/manifest/static-manifest.json",
        "!src/manifest/test-manifest.json",
        "!src/manifest/test-manifest-stub.ts",
        "!src/lib/types/smrt-generated/**",
        "scripts/generate-manifest.js",
        "scripts/generate-smrt-types.js",
        "AGENTS.md",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": [
        "src/manifest/static-manifest.ts",
        "src/manifest/static-manifest.json",
        "src/manifest/smrt-knowledge.json",
        "src/lib/types/smrt-generated/**"
      ],
      "cache": true
    },
    "generate:test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**/*.ts",
        "!src/**/*.d.ts",
        "!src/manifest/static-manifest.ts",
        "!src/manifest/test-manifest-stub.ts",
        "scripts/generate-test-manifest.js",
        "package.json",
        "tsconfig*.json",
        "vite.config.ts",
        "vite.config.js"
      ],
      "outputs": [
        "src/manifest/test-manifest.json",
        "src/manifest/test-manifest-stub.ts",
        ".smrt/manifest.json"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "inputs": [
        "src/**",
        "!src/manifest/test-manifest.json",
        "!src/manifest/test-manifest-stub.ts",
        "package.json",
        "tsconfig*.json",
        "vite.config.ts",
        "vite.config.js"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "docs/**",
        "tsconfig.*.tsbuildinfo"
      ],
      "cache": true
    },
    "prebuild": {
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": [
        "src/runtime/**"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build",
        "build",
        "generate:test",
        "@happyvertical/smrt-core#build"
      ],
      "env": [
        "NODE_ENV",
        "VITEST_MAX_WORKERS"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "scripts/**",
        "**/*.test.ts",
        "**/*.spec.ts",
        "conformance-baseline.yml",
        "package.json",
        "vitest.config.ts",
        "vitest.config.js"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:postgres": {
      "dependsOn": [
        "build",
        "generate:test"
      ],
      "env": [
        "CI_POSTGRES_BASE_URL",
        "DATABASE_URL",
        "TEST_DB_URL",
        "TEST_DB_ADAPTER",
        "SMRT_TEST_POSTGRES_URL"
      ],
      "cache": false
    },
    "@happyvertical/smrt-vitest#test:postgres": {
      "dependsOn": [
        "build",
        "generate:test",
        "@happyvertical/smrt-commerce#build",
        "@happyvertical/smrt-marketing#build"
      ],
      "env": [
        "CI_POSTGRES_BASE_URL",
        "DATABASE_URL",
        "TEST_DB_URL",
        "TEST_DB_ADAPTER",
        "SMRT_TEST_POSTGRES_URL"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "build",
        "generate:test"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "**/*.ts",
        "tsconfig*.json"
      ],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
