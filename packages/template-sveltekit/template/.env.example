# One canonical infrastructure profile. Local is the safe default when omitted.
SMRT_RUNTIME_PROFILE=local

# Optional stable application id and user-owned data path. The default is the
# operating system's application-data directory, never this source checkout.
# SMRT_APP_ID=my-app
# SMRT_DATA_DIR=/absolute/user-owned/path

# app:*, db:migrate, and the Vite dev/build launchers load this ignored file.
# Keep SMRT_* runtime identity here; Vite's mode-specific env files are not
# runtime identity sources.
# Direct `node build` does not; export HOST explicitly or prefer app:start.
# Local owner bootstrap is loopback-only.
HOST=127.0.0.1
PORT=5173

# Optional apex used for subdomain tenant selection.
# The value selects a tenant candidate; session membership still authorizes it.
TENANT_BASE_DOMAIN=demo.local
