{
  "extends": "../../tsconfig.package-typecheck.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "docs/**/*",
    "**/node_modules/**",
    "dist/**/*",
    "packages/*/dist/**/*",
    "packages/*/.svelte-kit/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
