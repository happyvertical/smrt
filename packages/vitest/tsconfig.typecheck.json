{
  "extends": "../../tsconfig.package-typecheck.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "allowUnusedLabels": true,
    "allowUnreachableCode": true,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/__tests__/fixtures/**"
  ]
}
