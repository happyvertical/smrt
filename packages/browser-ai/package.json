{
  "name": "@happyvertical/browser-ai",
  "version": "0.17.86",
  "description": "Framework-agnostic browser AI capabilities - STT, TTS, LLM with adapter pattern",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stt": {
      "types": "./dist/adapters/stt/index.d.ts",
      "default": "./dist/adapters/stt/index.js"
    },
    "./llm": {
      "types": "./dist/adapters/llm/index.d.ts",
      "default": "./dist/adapters/llm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npx vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "browser",
    "ai",
    "stt",
    "speech-to-text",
    "tts",
    "text-to-speech",
    "llm",
    "webllm",
    "whisper",
    "wasm"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/browser-ai"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0",
    "@mlc-ai/web-llm": ">=0.2.0",
    "@remotion/whisper-web": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "@remotion/whisper-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mlc-ai/web-llm": "^0.2.80",
    "@remotion/whisper-web": "^4.0.406",
    "@types/dom-speech-recognition": "^0.0.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
