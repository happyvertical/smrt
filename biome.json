{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**/*.{js,ts,tsx,jsx,svelte}",
      "packages/*/bin/**/*.js",
      "packages/*/playground/src/**/*.{js,ts,tsx,jsx,svelte}",
      "packages/*/playground/*.{js,ts}",
      "packages/*/scripts/**/*.{js,ts}",
      "scripts/**/*.{js,ts}",
      "docs/src/**/*.{js,ts,tsx,jsx}",
      "*.{js,ts,tsx,jsx}"
    ],
    "experimentalScannerIgnores": [
      "**/static-manifest.ts",
      "**/static-manifest.json"
    ],
    "ignoreUnknown": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noBlankTarget": "error"
      },
      "suspicious": {
        "noExplicitAny": "info",
        "noArrayIndexKey": "warn",
        "noConsole": "error",
        "noDocumentCookie": "error"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": [
                  "PascalCase"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/mock-*.ts",
        "**/test-*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noConsole": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    },
    {
      "includes": [
        "docs/**/*.js",
        "docs/**/*.jsx",
        "docs/**/*.ts",
        "docs/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "useAdjacentOverloadSignatures": "off"
          },
          "style": {
            "useNamingConvention": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off",
            "noBannedTypes": "off",
            "noThisInStatic": "off",
            "noUselessThisAlias": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**/*.svelte",
        "packages/*/playground/src/**/*.svelte"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "useNamingConvention": "off",
            "useConst": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/vite.config.ts",
        "**/vitest.config.ts",
        "**/rollup.config.js",
        "**/webpack.config.js",
        "**/*.config.ts",
        "**/*.config.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/bin/**/*.js",
        "packages/*/scripts/**/*.{js,ts}",
        "packages/*/playground/**/*.{js,ts}",
        "scripts/**/*.{js,ts}",
        "docs/src/**/*.{js,ts,tsx,jsx}"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**/vite-plugin/**",
        "packages/*/src/**/vite-plugin.ts",
        "packages/*/src/**/consumer-plugin/**",
        "packages/*/src/**/prebuild/**",
        "packages/*/src/**/scanner/**",
        "packages/*/src/**/generators/**",
        "packages/*/src/**/manifest/generator*",
        "packages/*/src/**/manifest/discover-*",
        "packages/*/src/**/manifest-utils.ts",
        "packages/*/src/**/browser-ai/**",
        "packages/*/src/**/testing/**",
        "packages/*/src/**/*.svelte",
        "packages/*/playground/**",
        "packages/smrt-svelte/src/**",
        "packages/scanner/src/**",
        "packages/vitest/src/**",
        "packages/smrt-dev-mcp/src/**",
        "packages/app-cli/src/**",
        "packages/cli/src/commands/**",
        "packages/core/src/mcp-advisor/**",
        "packages/core/src/schema/schema-aggregator.ts",
        "packages/cli/src/cli-generator.ts",
        "packages/cli/src/utils/generator.ts",
        "packages/cli/src/index.ts",
        "packages/assets/src/asset-serving.ts",
        "packages/products/src/index.ts",
        "packages/products/src/client.ts",
        "packages/products/src/mcp.ts",
        "packages/products/src/app/**",
        "packages/*/src/server.ts",
        "packages/*/src/**/*-server.ts",
        "packages/*/src/**/seed-*.ts",
        "packages/*/src/**/demo*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/chat/src/**/*.ts",
        "packages/chat/src/**/*.tsx",
        "packages/social/src/**/*.ts",
        "packages/social/src/**/*.tsx",
        "packages/smrt-app-mcp/src/**/*.ts",
        "packages/smrt-app-mcp/src/**/*.tsx",
        "packages/gnode/src/**/*.ts",
        "packages/gnode/src/**/*.tsx",
        "packages/assets-local/src/**/*.ts",
        "packages/assets-local/src/**/*.tsx",
        "packages/config/src/**/*.ts",
        "packages/config/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "!**/test/**",
        "!**/tests/**",
        "!**/mock-*.ts",
        "!**/test-*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
