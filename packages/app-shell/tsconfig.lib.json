{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/objects/index.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
