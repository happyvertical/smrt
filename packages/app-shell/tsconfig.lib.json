{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "types": ["node"]
  },
  "include": ["src/engine/**/*.ts", "src/lib/objects/index.ts"],
  "exclude": ["src/engine/**/*.test.ts"]
}
