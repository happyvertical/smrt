{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**/*.{js,ts,tsx,jsx,svelte}",
      "packages/*/bin/**/*.js",
      "packages/*/playground/src/**/*.{js,ts,tsx,jsx,svelte}",
      "packages/*/playground/*.{js,ts}",
      "packages/*/scripts/**/*.{js,ts}",
      "scripts/**/*.{js,ts}",
      "docs/src/**/*.{js,ts,tsx,jsx}",
      "*.{js,ts,tsx,jsx}"
    ],
    "experimentalScannerIgnores": [
      "**/static-manifest.ts",
      "**/static-manifest.json"
    ],
    "ignoreUnknown": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "info",
        "noArrayIndexKey": "warn",
        "noConsole": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": ["PascalCase"]
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/mock-*.ts",
        "**/test-*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noConsole": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    },
    {
      "includes": [
        "docs/**/*.js",
        "docs/**/*.jsx",
        "docs/**/*.ts",
        "docs/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "useAdjacentOverloadSignatures": "off"
          },
          "style": {
            "useNamingConvention": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off",
            "noBannedTypes": "off",
            "noThisInStatic": "off",
            "noUselessThisAlias": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**/*.svelte",
        "packages/*/playground/src/**/*.svelte"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "useNamingConvention": "off",
            "useConst": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/vite.config.ts",
        "**/vitest.config.ts",
        "**/rollup.config.js",
        "**/webpack.config.js",
        "**/*.config.ts",
        "**/*.config.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/bin/**/*.js",
        "packages/*/scripts/**/*.{js,ts}",
        "packages/*/playground/**/*.{js,ts}",
        "scripts/**/*.{js,ts}",
        "docs/src/**/*.{js,ts,tsx,jsx}"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/**/vite-plugin/**",
        "packages/*/src/**/vite-plugin.ts",
        "packages/*/src/**/consumer-plugin/**",
        "packages/*/src/**/prebuild/**",
        "packages/*/src/**/scanner/**",
        "packages/*/src/**/generators/**",
        "packages/*/src/**/manifest/generator*",
        "packages/*/src/**/manifest/discover-*",
        "packages/*/src/**/manifest-utils.ts",
        "packages/*/src/**/browser-ai/**",
        "packages/*/src/**/testing/**",
        "packages/*/src/**/*.svelte",
        "packages/*/playground/**",
        "packages/smrt-svelte/src/**",
        "packages/scanner/src/**",
        "packages/vitest/src/**",
        "packages/smrt-dev-mcp/src/**",
        "packages/app-cli/src/**",
        "packages/cli/src/commands/**",
        "packages/core/src/mcp-advisor/**",
        "packages/core/src/schema/schema-aggregator.ts",
        "packages/assets/src/asset-serving.ts",
        "packages/products/src/index.ts",
        "packages/products/src/client.ts",
        "packages/products/src/mcp.ts",
        "packages/products/src/app/**",
        "packages/*/src/server.ts",
        "packages/*/src/**/*-server.ts",
        "packages/*/src/**/seed-*.ts",
        "packages/*/src/**/demo*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/object.ts",
        "packages/core/src/collection.ts",
        "packages/core/src/registry.ts",
        "packages/core/src/class.ts",
        "packages/core/src/dispatch/bus.ts",
        "packages/core/src/schema/schema-manager.ts",
        "packages/core/src/schema/ddl/base-strategy.ts",
        "packages/core/src/manifest/manifest-loader.ts",
        "packages/core/src/manifest/store.ts",
        "packages/core/src/manifest/manager.ts",
        "packages/core/src/utils.ts",
        "packages/core/src/registry/inheritance-resolver.ts",
        "packages/core/src/registry/diagnostics.ts",
        "packages/core/src/registry/shared-state.ts",
        "packages/core/src/runtime/server.ts",
        "packages/core/src/runtime/mcp.ts",
        "packages/core/src/migrations/differ.ts",
        "packages/core/src/migrations/tracker.ts",
        "packages/core/src/embeddings/storage.ts",
        "packages/core/src/tools/tool-executor.ts",
        "packages/core/src/signals/bus.ts",
        "packages/core/src/errors.ts",
        "packages/core/src/adapters/pubsub.ts",
        "packages/core/src/adapters/cost-rates.ts",
        "packages/content/src/contents.ts",
        "packages/content/src/hooks.server.ts",
        "packages/content/src/routes/**/+server.ts",
        "packages/inventory/src/services/StockService.ts",
        "packages/inventory/src/services/dispatch-handlers.ts",
        "packages/languages/src/translation-job.ts",
        "packages/manufacturing/src/services/dispatch-handlers.ts",
        "packages/projects/src/collections/Projects.ts",
        "packages/projects/src/collections/PullRequests.ts",
        "packages/projects/src/collections/Repositories.ts",
        "packages/projects/src/models/Comment.ts",
        "packages/secrets/src/services/SecretService.ts",
        "packages/tenancy/src/interceptor.ts",
        "packages/users/src/sveltekit/index.ts",
        "packages/video/src/video-workflow.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
