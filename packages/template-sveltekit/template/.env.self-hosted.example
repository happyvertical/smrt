SMRT_RUNTIME_PROFILE=self-hosted
HOST=0.0.0.0
PORT=3000
# Put DATABASE_URL and POSTGRES_PASSWORD in the ignored `.env` file. Compose
# refuses to start if either secret is absent; never commit their values.
# Provider adapters keep real credentials private. Each setting must name an
# installed module whose checkReadiness() probes the real backing service.
# SMRT_AUTH_READINESS_MODULE=@your-org/auth-readiness
# SMRT_ASSETS_READINESS_MODULE=@your-org/assets-readiness
# SMRT_SECRETS_READINESS_MODULE=@your-org/secrets-readiness
SMRT_WORKER_CONCURRENCY=4
