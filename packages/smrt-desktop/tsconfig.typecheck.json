{
  "extends": "../../tsconfig.package-typecheck.json",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/__tests__/**",
    "src/**/__tests__/**",
    "src/testing/**",
    "src/**/testing/**"
  ]
}
