{
  "name": "@happyvertical/smrt-profiles",
  "version": "0.20.47",
  "description": "Profile management system with relationships, metadata, and reciprocal associations for SMRT framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "catalog:",
    "@happyvertical/files": "catalog:",
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@happyvertical/utils": "catalog:",
    "@noble/curves": "^1.8.1",
    "bech32": "^2.0.0"
  },
  "peerDependencies": {
    "@happyvertical/smrt-tenancy": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@types/node": "25.0.9",
    "fast-glob": "3.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "ai",
    "agents",
    "profiles",
    "relationships",
    "metadata",
    "smrt"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
