{
  "name": "@happyvertical/smrt-content",
  "version": "0.19.44",
  "description": "Content processing module for SMRT framework - handles documents, web content, and media",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".claude-meta.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": "./dist/manifest.json"
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "^0.66.9",
    "@happyvertical/documents": "^0.66.9",
    "@happyvertical/files": "^0.66.9",
    "@happyvertical/geo": "^0.66.9",
    "@happyvertical/images": "^0.66.9",
    "@happyvertical/logger": "^0.66.9",
    "@happyvertical/ocr": "^0.60.6",
    "@happyvertical/pdf": "^0.60.4",
    "@happyvertical/smrt-assets": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/spider": "^0.60.6",
    "@happyvertical/sql": "^0.66.9",
    "@happyvertical/utils": "^0.66.9",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "25.0.9",
    "svelte": "^5.46.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "ai",
    "agents",
    "content",
    "documents",
    "pdf",
    "web-scraping"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
