{
  "name": "@smrt-app/sveltekit-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "smrt app dev",
    "build": "smrt app build",
    "preview": "smrt app start",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate": "vite build && smrt app migrate",
    "app:install": "smrt app install",
    "app:setup": "smrt app setup",
    "app:recover": "smrt app recover",
    "app:start": "smrt app start",
    "app:doctor": "smrt app doctor",
    "app:open": "smrt app open",
    "app:stop": "smrt app stop",
    "app:backup": "smrt app backup",
    "app:export": "smrt app export",
    "app:import": "smrt app import",
    "mcp-apps:validate": "pnpm exec smrt mcp-apps validate --output-dir ./mcp-apps",
    "worker": "smrt app worker task",
    "worker:schedule": "smrt app worker schedule"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "@happyvertical/smrt-cli": "^0.55.10"
  },
  "dependencies": {
    "@happyvertical/smrt-app-runtime": "^0.55.10",
    "@happyvertical/smrt-config": "^0.55.10",
    "@happyvertical/smrt-core": "^0.55.10",
    "@happyvertical/smrt-jobs": "^0.55.10",
    "@happyvertical/smrt-profiles": "^0.55.10",
    "@happyvertical/smrt-svelte": "^0.55.10",
    "@happyvertical/smrt-tenancy": "^0.55.10",
    "@happyvertical/smrt-ui": "^0.55.10",
    "@happyvertical/smrt-users": "^0.55.10",
    "@happyvertical/smrt-web": "^0.55.10",
    "@happyvertical/sql": "^0.89.12",
    "@modelcontextprotocol/server": "^2.0.0"
  }
}
