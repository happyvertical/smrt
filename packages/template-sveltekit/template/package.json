{
  "name": "@smrt-app/sveltekit-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "10.34.4"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/smrt-vite.mjs dev",
    "build": "node --env-file-if-exists=.env scripts/smrt-vite.mjs build",
    "preview": "node scripts/smrt-app.mjs start",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate": "vite build && node scripts/smrt-prepare-migration.mjs",
    "app:install": "node scripts/smrt-app.mjs install",
    "app:setup": "node scripts/smrt-app.mjs setup",
    "app:recover": "node scripts/smrt-app.mjs recover",
    "app:start": "node scripts/smrt-app.mjs start",
    "app:doctor": "node scripts/smrt-app.mjs doctor",
    "app:open": "node scripts/smrt-app.mjs open",
    "app:stop": "node scripts/smrt-app.mjs stop",
    "app:backup": "node scripts/smrt-app.mjs backup",
    "app:export": "node scripts/smrt-app.mjs export",
    "app:import": "node scripts/smrt-app.mjs import",
    "worker": "node scripts/smrt-worker.mjs task",
    "worker:schedule": "node scripts/smrt-worker.mjs schedule"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "@happyvertical/smrt-cli": "^0.44.0"
  },
  "dependencies": {
    "@happyvertical/smrt-app-runtime": "^0.44.0",
    "@happyvertical/smrt-config": "^0.44.0",
    "@happyvertical/smrt-core": "^0.44.0",
    "@happyvertical/smrt-jobs": "^0.44.0",
    "@happyvertical/smrt-profiles": "^0.44.0",
    "@happyvertical/smrt-svelte": "^0.44.0",
    "@happyvertical/smrt-tenancy": "^0.44.0",
    "@happyvertical/smrt-ui": "^0.44.0",
    "@happyvertical/smrt-users": "^0.44.0",
    "@happyvertical/smrt-web": "^0.44.0",
    "@happyvertical/sql": "^0.89.4",
    "@modelcontextprotocol/server": "^2.0.0"
  }
}
