{
  "name": "@happyvertical/smrt-planner",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "The smrt planner as a mountable Svelte component with a typed command set and plan snapshot.",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "app"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./app": {
      "types": "./dist/core/app.d.ts",
      "default": "./dist/core/app.js"
    },
    "./app/*": "./app/*",
    "./commands": {
      "types": "./dist/planner/commands/index.d.ts",
      "default": "./dist/planner/commands/index.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-catalog.ts",
    "typecheck": "svelte-kit sync && tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:package": "node scripts/test-packed-package.mjs",
    "test:release-workflow": "node scripts/test-release-workflow.mjs",
    "lint": "biome ci .",
    "package": "svelte-package -i src/lib -o dist --tsconfig tsconfig.package.json && node scripts/package-app.ts && publint"
  },
  "dependencies": {
    "@happyvertical/ai": "^0.103.1",
    "@happyvertical/smrt-chat": "^0.55.12",
    "@happyvertical/smrt-core": "^0.55.12",
    "@happyvertical/smrt-svelte": "^0.55.12",
    "@happyvertical/smrt-ui": "^0.55.12",
    "@happyvertical/speech": "^0.103.1",
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.57.1"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.6",
    "publint": "^0.3.25",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  }
}
