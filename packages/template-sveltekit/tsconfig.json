{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  // `template/src` must stay included: vitest's vite:oxc transform resolves
  // each imported template file's tsconfig by matching these include
  // patterns, and fails with "Tsconfig not found" for template sources it
  // can't match (the template's own tsconfig.json extends the `.svelte-kit/`
  // stub and is not what gets discovered for files imported from tests).
  "include": ["__tests__/**/*.ts", "template/src/**/*.ts"]
}
