{
  "name": "smrt-playground-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test:e2e": "pnpm exec playwright test -c playwright.config.ts",
    "test:e2e:update-snapshots": "pnpm exec playwright test -c playwright.config.ts theme-gallery --update-snapshots",
    "test:e2e:headed": "pnpm exec playwright test -c playwright.config.ts --headed",
    "test:visual": "pnpm exec playwright test -c playwright.visual.config.ts",
    "test:visual:update": "pnpm run test:visual --update-snapshots",
    "test:visual:container": "node ../e2e/run-container.mjs"
  },
  "devDependencies": {
    "@happyvertical/smrt-playground": "workspace:*",
    "@happyvertical/smrt-svelte": "workspace:*",
    "@happyvertical/smrt-ui": "workspace:*",
    "@happyvertical/smrt-web": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.1",
    "vite": "8.1.4"
  }
}
