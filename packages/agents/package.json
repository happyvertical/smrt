{
  "name": "@happyvertical/smrt-agents",
  "version": "0.21.0",
  "type": "module",
  "description": "Agent framework for building autonomous actors in the SMRT ecosystem",
  "author": "HappyVertical",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./vite": {
      "import": "./dist/vite-plugin.js",
      "types": "./dist/vite-plugin.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "vite build && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "build:watch": "vite build --watch",
    "test": "npx vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "catalog:",
    "@happyvertical/files": "catalog:",
    "@happyvertical/smrt-config": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/utils": "catalog:"
  },
  "devDependencies": {
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-svelte": "workspace:*",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@sveltejs/package": "^2.5.7",
    "@types/node": "25.0.9",
    "fast-glob": "3.3.3",
    "svelte": "^5.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "agent",
    "automation",
    "smrt",
    "framework"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
