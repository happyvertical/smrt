{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/lib/lib",
    "rootDir": "./src/lib",
    "composite": true,
    "declaration": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/lib/components/**/*",
    "src/lib/features/**/*",
    "src/lib/stores/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
