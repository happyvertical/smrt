{
  "name": "@happyvertical/smrt-tenancy",
  "version": "0.20.40",
  "description": "Production-ready multi-tenancy framework for SMRT with automatic tenant isolation and enforcement",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    }
  },
  "scripts": {
    "build": "vite build --mode library && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@happyvertical/utils": "catalog:"
  },
  "devDependencies": {
    "@happyvertical/smrt-svelte": "workspace:*",
    "@happyvertical/smrt-users": "workspace:*",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "25.0.9",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@happyvertical/smrt-users": "workspace:*",
    "@happyvertical/smrt-svelte": "workspace:*",
    "svelte": "^5.18.0"
  },
  "peerDependenciesMeta": {
    "@happyvertical/smrt-users": {
      "optional": true
    },
    "@happyvertical/smrt-svelte": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "keywords": [
    "ai",
    "agents",
    "multi-tenancy",
    "tenancy",
    "isolation",
    "smrt"
  ],
  "author": "HAVE Team",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
