{
  "extends": "../../tsconfig.package-typecheck.json",
  // The declaration build checks unused declarations in this package.
  "compilerOptions": {
    "target": "ES2022",
    "esModuleInterop": true,
    "noImplicitReturns": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
