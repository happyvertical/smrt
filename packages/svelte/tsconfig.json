{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.story.ts",
    "**/*.story.svelte",
    "dist",
    ".histoire"
  ]
}
