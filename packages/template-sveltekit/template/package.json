{
  "name": "smrt-sveltekit-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate": "vite build && smrt db:migrate"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "@happyvertical/smrt-cli": "^0.40.68"
  },
  "dependencies": {
    "@happyvertical/smrt-config": "^0.40.68",
    "@happyvertical/smrt-core": "^0.40.68",
    "@happyvertical/smrt-profiles": "^0.40.68",
    "@happyvertical/smrt-svelte": "^0.40.68",
    "@happyvertical/smrt-tenancy": "^0.40.68",
    "@happyvertical/smrt-ui": "^0.40.68",
    "@happyvertical/smrt-users": "^0.40.68",
    "@modelcontextprotocol/server": "^2.0.0"
  }
}
