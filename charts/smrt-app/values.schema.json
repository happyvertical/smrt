        "privateBuckets"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "className": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        },
        "tlsSecretName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nginx.ingress.kubernetes.io/proxy-body-size": {
              "enum": [
                "1m",
                "2m",
                "4m",
                "8m",
                "10m",
                "11m"
