{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$",
          "maxLength": 20
        },
        "phase": {
          "enum": [
            "maintenance",
            "stopped",
            "migrate",
            "verify",
            "active"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        }
      },
      "required": [
        "id",
        "phase",
        "sequence",
        "attempt"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        }
      },
      "required": [
        "name",
        "environment"
      ]
    },
    "current": {
      "oneOf": [
        {
          "const": false
        },
        {
          "$ref": "#/definitions/runtime"
