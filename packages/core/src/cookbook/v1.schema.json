{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-m-r-t.dev/schemas/cookbook/v1.json",
  "title": "SMRT cookbook v1",
  "description": "What an app is made of: recipes, features, field policies, exposure, shell layout, theme and overview pages. New optional fields are added within v1; readers ignore unknown keys.",
  "type": "object",
  "required": ["version", "recipes", "policies"],
  "properties": {
    "models": {
      "type": "object",
      "required": [
        "version",
        "packageName",
        "lists",
        "fields"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "packageName": {
          "type": "string",
          "pattern": "^@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        },
        "lists": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/appModelList"
          }
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "pattern": "^@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*:[A-Z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/appModelFields"
          }
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "enum": [
        "https://s-m-r-t.dev/schemas/cookbook/v1.json",
        "https://s-m-r-t.dev/schemas/blueprint/v1.json"
      ]
    },
    "version": { "const": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "specs": { "type": "string", "maxLength": 20000, "description": "Free-text product requirements beyond the recipes and features: what the app must also do. Agents treat it as requirements to build." },
    "recipes": { "type": "array", "items": { "type": "string" } },
    "features": { "type": "array", "items": { "type": "string" } },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policyRow" } },
    "exposure": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "enum": ["api", "mcp", "cli"] }
      }
    },
    "layout": { "$ref": "#/$defs/layout" },
    "theme": { "$ref": "#/$defs/theme" },
    "overviews": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$" },
      "additionalProperties": { "$ref": "#/$defs/overviewOverride" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "appModelField": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "longText",
            "integer",
            "decimal",
            "money",
            "date",
            "datetime",
            "boolean",
            "choice",
            "reference"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "target": {
          "type": "string",
          "pattern": "^(@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*:)?[A-Z][A-Za-z0-9]*$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "money"
              }
            }
          },
          "then": {
            "properties": { "currency": {} },
            "required": [
              "currency"
            ]
          },
          "else": {
            "not": {
              "properties": { "currency": {} },
              "required": [
                "currency"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "properties": { "choices": {} },
            "required": [
              "choices"
            ]
          },
          "else": {
            "not": {
              "properties": { "choices": {} },
              "required": [
                "choices"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            }
          },
          "then": {
            "properties": { "target": {} },
            "required": [
              "target"
            ]
          },
          "else": {
            "not": {
              "properties": { "target": {} },
              "required": [
                "target"
              ]
            }
          }
        }
      ]
    },
    "appModelFields": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,63}$",
        "not": {
          "enum": [
            "__proto__",
            "prototype",
            "constructor",
            "id",
            "slug",
            "context",
            "tenantId",
            "displayLabel",
            "createdAt",
            "updatedAt",
            "metaType",
            "metaData",
            "_meta_type",
            "_meta_data",
            "abstract",
            "arguments",
            "await",
            "boolean",
            "break",
            "byte",
            "case",
            "catch",
            "char",
            "class",
            "const",
            "continue",
            "debugger",
            "default",
            "delete",
            "do",
            "double",
            "else",
            "enum",
            "eval",
            "export",
            "extends",
            "false",
            "final",
            "finally",
            "float",
            "for",
            "function",
            "goto",
            "if",
            "implements",
            "import",
            "in",
            "instanceof",
            "int",
            "interface",
            "let",
            "long",
            "native",
            "new",
            "null",
            "package",
            "private",
            "protected",
            "public",
            "return",
            "short",
            "static",
            "super",
            "switch",
            "synchronized",
            "this",
            "throw",
            "throws",
            "transient",
            "true",
            "try",
            "typeof",
            "var",
            "void",
            "volatile",
            "while",
            "with",
            "yield",
            "save",
            "initialize",
            "toJSON",
            "toPublicJSON",
            "then",
            "select",
            "from",
            "where",
            "table",
            "column",
            "group",
            "order",
            "insert",
            "update",
            "values",
            "join",
            "limit",
            "offset",
            "drop",
            "alter",
            "create",
            "index",
            "primary",
            "foreign",
            "key",
            "references"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/appModelField"
      }
    },
    "appModelList": {
      "type": "object",
      "required": [
        "label",
        "icon",
        "displayField",
        "fields"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "icon": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "displayField": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
        },
        "fields": {
          "$ref": "#/$defs/appModelFields"
        }
      },
      "additionalProperties": false
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "policyRow": {
      "type": "object",
      "required": ["objectRef", "fieldName", "scopeType"],
      "properties": {
        "objectRef": { "type": "string", "minLength": 1 },
        "fieldName": { "type": "string", "minLength": 1 },
        "scopeType": { "const": "app" },
        "defaultValue": { "type": ["string", "null"] },
        "visibility": { "enum": ["basic", "advanced", "hidden", null] },
        "help": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "displayOrder": { "type": ["number", "null"] },
        "locked": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "const": 1 },
        "sectionOrder": { "$ref": "#/$defs/stringList" },
        "hidden": { "$ref": "#/$defs/stringList" },
        "itemOrder": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringList" }
        },
        "moved": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "placements": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/shellSlot" }
        },
        "sections": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
              }
            },
            "additionalProperties": true
          }
        },
        "panels": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "customSections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "shellSlot": {
      "enum": [
        "header.start",
        "header.center",
        "header.end",
        "footer.start",
        "footer.center",
        "footer.end",
        "leftSidebar.header",
        "leftSidebar.footer",
        "rightSidebar.header",
        "rightSidebar.footer"
      ]
    },
    "theme": {
      "type": "object",
      "properties": {
        "preset": { "type": "string" },
        "colorScheme": { "enum": ["light", "dark", "system"] },
        "borderRadius": { "enum": ["none", "sm", "md", "lg", "xl", "full"] },
        "density": { "enum": ["comfortable", "touch"] },
        "contrast": { "enum": ["auto", "standard", "more"] },
        "fontFamily": { "type": "string", "minLength": 1, "description": "Host font key, independent of the preset." },
        "customCss": { "type": "string", "maxLength": 65536, "description": "Stored CSS source text; consumers do not execute it automatically." },
        "custom": {
          "type": "object",
          "required": ["primary"],
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "fontFamily": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "overviewOverride": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "const": 1 },
        "order": { "$ref": "#/$defs/stringList" },
        "removed": { "$ref": "#/$defs/stringList" },
        "added": { "type": "array", "items": { "$ref": "#/$defs/overviewWidget" } },
        "changed": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/overviewPatch" }
        }
      },
      "additionalProperties": true
    },
    "overviewWidget": {
      "type": "object",
      "required": ["id", "type", "span", "options"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "span": { "type": "integer", "minimum": 1, "maximum": 4 },
        "options": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "overviewPatch": {
      "type": "object",
      "properties": {
        "span": { "type": "integer", "minimum": 1, "maximum": 4 },
        "options": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
