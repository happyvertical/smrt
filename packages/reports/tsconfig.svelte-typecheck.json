{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "svelte"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "ambient.d.ts",
    "src/playground.ts",
    "src/svelte/**/*.ts",
    "src/svelte/**/*.svelte"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
