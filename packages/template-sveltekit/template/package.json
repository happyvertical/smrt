{
  "name": "@smrt-app/sveltekit-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/smrt-vite.mjs dev",
    "build": "node --env-file-if-exists=.env scripts/smrt-vite.mjs build",
    "preview": "node scripts/smrt-app.mjs start",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate": "vite build && node scripts/smrt-prepare-migration.mjs",
    "app:install": "node scripts/smrt-app.mjs install",
    "app:setup": "node scripts/smrt-app.mjs setup",
    "app:recover": "node scripts/smrt-app.mjs recover",
    "app:start": "node scripts/smrt-app.mjs start",
    "app:doctor": "node scripts/smrt-app.mjs doctor",
    "app:open": "node scripts/smrt-app.mjs open",
    "app:stop": "node scripts/smrt-app.mjs stop",
    "app:backup": "node scripts/smrt-app.mjs backup",
    "app:export": "node scripts/smrt-app.mjs export",
    "app:import": "node scripts/smrt-app.mjs import",
    "worker": "node scripts/smrt-worker.mjs task",
    "worker:schedule": "node scripts/smrt-worker.mjs schedule"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "@happyvertical/smrt-cli": "^0.45.3"
  },
  "dependencies": {
    "@happyvertical/smrt-app-runtime": "^0.45.3",
    "@happyvertical/smrt-config": "^0.45.3",
    "@happyvertical/smrt-core": "^0.45.3",
    "@happyvertical/smrt-jobs": "^0.45.3",
    "@happyvertical/smrt-profiles": "^0.45.3",
    "@happyvertical/smrt-svelte": "^0.45.3",
    "@happyvertical/smrt-tenancy": "^0.45.3",
    "@happyvertical/smrt-ui": "^0.45.3",
    "@happyvertical/smrt-users": "^0.45.3",
    "@happyvertical/smrt-web": "^0.45.3",
    "@happyvertical/sql": "^0.89.6",
    "@modelcontextprotocol/server": "^2.0.0"
  }
}
