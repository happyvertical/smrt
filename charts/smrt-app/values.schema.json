                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "host": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
              },
              "workload": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "tlsSecretName": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
