{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "generate": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        "!src/**/__tests__/**",
        "!src/manifest/static-manifest.ts",
        "!src/manifest/static-manifest.json",
        "!src/manifest/test-manifest.json",
        "!src/manifest/test-manifest-stub.ts",
        "!src/lib/types/smrt-generated/**",
        "scripts/generate-manifest.js",
        "scripts/generate-smrt-types.js",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": [
        "src/manifest/static-manifest.ts",
        "src/manifest/static-manifest.json",
        "src/lib/types/smrt-generated/**"
      ],
      "cache": true
    },
    "generate:test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/__tests__/**/*.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "scripts/generate-test-manifest.js",
        "package.json",
        "tsconfig.json"
      ],
      "outputs": [
        "src/manifest/test-manifest.json",
        "src/manifest/test-manifest-stub.ts",
        ".smrt/manifest.json"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts", "vite.config.js"],
      "outputs": ["dist/**", ".next/**", "docs/**", "tsconfig.*.tsbuildinfo"],
      "cache": true
    },
    "prebuild": {
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["src/runtime/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build", "build", "generate:test"],
      "inputs": ["src/**", "test/**", "**/*.test.ts", "**/*.spec.ts", "package.json", "vitest.config.ts", "vitest.config.js"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**", "test/**", "**/*.ts", "**/*.js", "biome.json"],
      "cache": true
    },
    "lint:fix": {
      "inputs": ["src/**", "test/**", "**/*.ts", "**/*.js", "biome.json"],
      "cache": false
    },
    "format": {
      "inputs": ["src/**", "test/**", "**/*.ts", "**/*.js", "**/*.json", "**/*.md", "biome.json"],
      "cache": false
    },
    "format-check": {
      "inputs": ["src/**", "test/**", "**/*.ts", "**/*.js", "**/*.json", "**/*.md", "biome.json"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build", "generate:test"],
      "inputs": ["src/**", "test/**", "**/*.ts", "tsconfig.json"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "docs": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "README.md", "CLAUDE.md", "package.json"],
      "outputs": ["docs/**", "manual/**"],
      "cache": true
    }
  }
}
