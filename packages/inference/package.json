{
  "name": "@happyvertical/smrt-inference",
  "version": "0.60.14",
  "description": "Inference alias chains with classified failures, recorded fallback and ladder degradation, plus the smrt doctor --ai binding check, for SMRT inference tiers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "vite build --mode library",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "prepack": "node ../../scripts/prepack-package.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js ."
  },
  "dependencies": {
    "@happyvertical/ai": "catalog:",
    "@happyvertical/smrt-config": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*"
  },
  "devDependencies": {
    "@happyvertical/smrt-prompts": "workspace:*",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@happyvertical/smrt-prompts": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@happyvertical/smrt-prompts": {
      "optional": true
    }
  },
  "keywords": [
    "smrt",
    "ai",
    "inference",
    "fallback",
    "routing"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/inference"
  }
}
