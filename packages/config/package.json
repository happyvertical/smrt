{
  "name": "@happyvertical/smrt-config",
  "version": "0.37.4",
  "type": "module",
  "description": "Centralized configuration management for SMRT modules",
  "author": "HappyVertical",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happyvertical/smrt-types": "workspace:*",
    "cosmiconfig": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "config",
    "configuration",
    "smrt",
    "settings"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/config"
  }
}
