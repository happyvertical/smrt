{
  "name": "@happyvertical/smrt-commerce",
  "version": "0.55.7",
  "smrtJsdoc": "strict",
  "description": "Commerce models for the SMRT framework - contracts, fulfillments, payments",
  "type": "module",
  "smrtRawPrimitives": "strict",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json",
    "./playground": {
      "types": "./dist/playground.d.ts",
      "import": "./dist/playground.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    },
    "./invoices": {
      "types": "./dist/invoices.d.ts",
      "import": "./dist/invoices.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build --mode library && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json && node ../../scripts/prune-svelte-package-artifacts.js dist",
    "build:watch": "vite build --mode library --watch",
    "clean": "rm -rf dist",
    "dev": "npm run build:watch",
    "prepack": "node ../../scripts/prepack-package.js",
    "test": "vitest run && pnpm run test:ui",
    "test:postgres": "node ../../scripts/run-with-ci-postgres.mjs -- pnpm exec vitest run optional.test.ts",
    "typecheck": "tsc --noEmit && node ../../scripts/svelte-check-a11y.mjs --tsconfig ./tsconfig.svelte.json",
    "check": "pnpm exec svelte-check --tsconfig ./tsconfig.svelte.json",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js .",
    "test:ui": "vitest run --config vitest.parties.config.ts && vitest run --config vitest.quotes.config.ts && vitest run --config vitest.invoices.config.ts && vitest run --config vitest.pricing.config.ts && vitest run --config vitest.purchasing.config.ts",
    "test:e2e": "pnpm run test:e2e:parties && pnpm run test:e2e:quotes && pnpm run test:e2e:invoices && pnpm run test:e2e:pricing && pnpm run test:e2e:purchasing",
    "test:e2e:parties": "playwright test -c playwright.parties.config.ts",
    "test:e2e:quotes": "cd ../.. && node packages/commerce/test-support/quote-browser.mjs",
    "test:e2e:invoices": "playwright test -c e2e/invoices/playwright.config.ts",
    "test:e2e:pricing": "cd ../.. && QUOTE_BROWSER_EXTENSION=packages/commerce/test-support/pricing-browser.mjs node packages/commerce/test-support/quote-browser.mjs",
    "test:e2e:purchasing": "cd ../.. && QUOTE_BROWSER_EXTENSION=packages/commerce/test-support/purchasing-browser-extension.mjs node packages/commerce/test-support/quote-browser.mjs"
  },
  "keywords": [
    "smrt",
    "commerce",
    "contracts",
    "fulfillment",
    "payments",
    "ledger",
    "accounting"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/commerce"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/accounting": "catalog:",
    "@happyvertical/payments": "catalog:",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-jobs": "workspace:*",
    "@happyvertical/smrt-ledgers": "workspace:*",
    "@happyvertical/smrt-subscriptions": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/smrt-types": "workspace:*",
    "@happyvertical/smrt-ui": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happyvertical/smrt-vitest": "workspace:*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "24.13.6",
    "fast-glob": "^3.3.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
