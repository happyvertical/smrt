{
  "name": "@happyvertical/smrt-agents",
  "version": "0.19.61",
  "type": "module",
  "description": "Agent framework for building autonomous actors in the SMRT ecosystem",
  "author": "HappyVertical",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "files": [
    "dist",
    ".claude-meta.json",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/generate-stub-from-manifest.js",
    "build:watch": "vite build --watch",
    "generate:test": "node scripts/generate-test-manifest.js",
    "test": "pnpm run generate:test && npx vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "^0.66.9",
    "@happyvertical/files": "^0.66.9",
    "@happyvertical/smrt-config": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/utils": "^0.66.9"
  },
  "devDependencies": {
    "@happyvertical/logger": "^0.66.9",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@happyvertical/sql": "^0.66.9",
    "@types/node": "25.0.9",
    "fast-glob": "3.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "agent",
    "automation",
    "smrt",
    "framework"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
