{
  "name": "@happyvertical/smrt-vitest",
  "version": "0.40.68",
  "description": "Vitest plugin for automatic cross-package manifest loading in SMRT tests",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    },
    "./svelte-setup": {
      "types": "./dist/svelte-setup.d.ts",
      "import": "./dist/svelte-setup.js",
      "default": "./dist/svelte-setup.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js",
      "default": "./dist/a11y.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:postgres": "node ../../scripts/run-with-ci-postgres.mjs -- pnpm exec vitest run src/__tests__/issue-2069-postgres-manifest.optional.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "smrt",
    "vitest",
    "plugin",
    "testing",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/vitest"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12"
  },
  "peerDependencies": {
    "svelte": ">=5.56.9",
    "vitest": "4.1.10"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "svelte": "^5.56.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "author": "HappyVertical"
}
