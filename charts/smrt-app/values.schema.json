                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nginx.ingress.kubernetes.io/proxy-body-size": {
                    "enum": [
                      "1m",
                      "2m",
                      "4m",
                      "8m",
                      "10m",
                      "11m"
                    ]
                  },
                  "nginx.ingress.kubernetes.io/proxy-buffer-size": {
                    "enum": [
                      "4k",
                      "8k",
                      "16k",
                      "32k",
                      "64k"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "host",
        "className"
      ]
    }
  },
  "required": [
    "release",
    "app",
    "current",
    "target",
    "maintenance",
    "bindings",
    "ingress"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
