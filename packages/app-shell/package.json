{
  "name": "@happyvertical/smrt-app-shell",
  "version": "0.66.1",
  "description": "A smrt app that builds and runs a person's own smrt app from definitions",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/objects/index.d.ts",
      "import": "./dist/lib/objects/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./engine/worker": {
      "import": "./dist/engine/app-worker.js"
    },
    "./manifest": "./dist/manifest.json"
  },
  "files": [
    "build",
    "dist",
    "CLAUDE.md",
    "AGENTS.md",
    "agents"
  ],
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "tsc -p tsconfig.lib.json && node tools/bundle-worker.mjs && svelte-kit sync && vite build && node tools/publish-manifest.mjs",
    "preview": "vite preview",
    "start": "node build",
    "clean": "rm -rf dist build .svelte-kit",
    "test:bundled-worker": "SMRT_APP_SHELL_WORKER=bundle vitest run src/engine",
    "test": "svelte-kit sync && vitest run && vitest run -c vitest.pglite.config.ts && vitest run -c vitest.dom.config.ts",
    "test:postgres": "node ../../scripts/run-with-ci-postgres.mjs -- pnpm exec vitest run -c vitest.postgres.config.ts",
    "test:pglite": "vitest run -c vitest.pglite.config.ts",
    "typecheck": "svelte-kit sync && node ../../scripts/write-source-typecheck-config.mjs tsconfig.json .svelte-kit/tsconfig.typecheck.json && tsc -p .svelte-kit/tsconfig.typecheck.json && node ../../scripts/svelte-check-workspace.mjs --config ./svelte.config.typecheck.js --tsconfig ./.svelte-kit/tsconfig.typecheck.json",
    "prepack": "node ../../scripts/prepack-package.js"
  },
  "dependencies": {
    "@happyvertical/ai": "catalog:",
    "@happyvertical/smrt-app-mcp": "workspace:*",
    "@happyvertical/smrt-app-runtime": "workspace:*",
    "@happyvertical/smrt-chat": "workspace:*",
    "@happyvertical/smrt-config": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-prompts": "workspace:*",
    "@happyvertical/smrt-inference": "workspace:*",
    "@happyvertical/smrt-preferences": "workspace:*",
    "@happyvertical/smrt-profiles": "workspace:*",
    "@happyvertical/smrt-reports": "workspace:*",
    "@happyvertical/smrt-secrets": "workspace:*",
    "@happyvertical/smrt-svelte": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/smrt-ui": "workspace:*",
    "@happyvertical/smrt-users": "workspace:*",
    "@happyvertical/smrt-web": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@modelcontextprotocol/server": "2.3.1",
    "quickjs-emscripten": "0.31.0",
    "@happyvertical/spreadsheets": "catalog:",
    "@happyvertical/smrt-spreadsheets": "workspace:*",
    "@happyvertical/smrt-subscriptions": "workspace:*",
    "@happyvertical/smrt-workflows": "workspace:*",
    "@happyvertical/smrt-jobs": "workspace:*",
    "ajv": "8.20.0",
    "libsql": "0.5.29"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5.0 <1"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.10"
  },
  "keywords": [
    "smrt",
    "app-shell",
    "local-first"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/app-shell"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
