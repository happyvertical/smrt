{
  "name": "@happyvertical/smrt-agents",
  "version": "0.17.25",
  "type": "module",
  "description": "Agent framework for building autonomous actors in the SMRT ecosystem",
  "author": "HappyVertical",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": "./dist/manifest.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/generate-stub-from-manifest.js",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@happyvertical/ai": "0.59.2",
    "@happyvertical/files": "0.59.2",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/utils": "0.59.2"
  },
  "devDependencies": {
    "@happyvertical/logger": "0.59.2",
    "@happyvertical/sql": "0.59.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "agent",
    "automation",
    "smrt",
    "framework"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
