{
  "mcpServers": {
    "smrt-docs-mcp": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "tsx",
        "packages/smrt-docs-mcp/src/index.ts"
      ],
      "env": {
        "DEBUG": "false"
      }
    },
    "smrt-dev-mcp": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "tsx",
        "packages/smrt-dev-mcp/src/index.ts"
      ],
      "env": {
        "DEBUG": "false"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "./scripts/mcp-servers/playwright.sh",
      "args": [],
      "env": {
        "PLAYWRIGHT_MCP_ISOLATED": "true"
      }
    },
    "svelte": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sveltejs/mcp"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9227"
      ]
    },
    "gemini": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "gemini-mcp-tool"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    }
  }
}
