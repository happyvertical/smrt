{
  "name": "@happyvertical/smrt-products",
  "version": "0.29.1",
  "description": "SMRT products module: triple-purpose microservice template for standalone apps, federated modules, and NPM libraries",
  "author": "HappyVertical",
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "files": [
    "CLAUDE.md",
    "dist/app",
    "dist/federation",
    "dist/lib",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "svelte": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./models": {
      "types": "./dist/lib/models.d.ts",
      "default": "./dist/lib/models.js"
    },
    "./components": {
      "types": "./dist/lib/components.d.ts",
      "default": "./dist/lib/components.js"
    },
    "./stores": {
      "types": "./dist/lib/stores.d.ts",
      "default": "./dist/lib/stores.js"
    },
    "./generated": {
      "types": "./dist/lib/generated.d.ts",
      "default": "./dist/lib/generated.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./collections": {
      "types": "./dist/lib/collections.d.ts",
      "default": "./dist/lib/collections.js"
    },
    "./manifest": "./dist/lib/manifest.json",
    "./manifest.json": "./dist/lib/manifest.json"
  },
  "dependencies": {
    "@happyvertical/ai": "catalog:",
    "@happyvertical/files": "catalog:",
    "@happyvertical/logger": "catalog:",
    "@happyvertical/smrt-assets": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-scanner": "workspace:*",
    "@happyvertical/smrt-tenancy": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@happyvertical/utils": "catalog:",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "svelte": "^5.46.4"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "25.0.9",
    "@happyvertical/smrt-vitest": "workspace:*",
    "concurrently": "^9.2.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm run dev:standalone\" \"npm run dev:federation\"",
    "dev:standalone": "vite dev --mode standalone --port 3001",
    "dev:federation": "vite dev --mode federation --port 3002",
    "dev:library": "vite build --mode library --watch",
    "generate": "node scripts/generate-smrt-types.js",
    "typecheck": "npm run generate && tsc --noEmit -p tsconfig.json",
    "build": "npm run build:lib",
    "build:all": "npm run clean && npm run generate && npm run build:lib && npm run build:app && npm run build:federation",
    "build:lib": "vite build --mode library && svelte-package -i src/lib/components -o dist/lib/lib/components --tsconfig tsconfig.svelte.json && svelte-package -i src/lib/features -o dist/lib/lib/features --tsconfig tsconfig.svelte.json && svelte-package -i src/lib/stores -o dist/lib/lib/stores --tsconfig tsconfig.svelte.json",
    "build:app": "vite build --mode standalone",
    "build:federation": "vite build --mode federation",
    "generate:mcp": "tsx src/mcp.ts",
    "mcp": "node dist/mcp-server.js",
    "start": "npm run start:standalone",
    "start:standalone": "node dist/app/main.js",
    "start:federation": "node dist/federation/main.js",
    "preview": "vite preview",
    "prepack": "node ../../scripts/prepack-package.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js .",
    "clean": "rm -rf dist src/lib/types/smrt-generated",
    "prepare": "test -f ../smrt/dist/vite-plugin/index.js && npm run build:lib || echo 'Skipping products build:lib (smrt vite-plugin not available yet)'"
  },
  "keywords": [
    "smrt",
    "microservice",
    "module-federation",
    "svelte",
    "typescript",
    "auto-generation"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/products"
  }
}
