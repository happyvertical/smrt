{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/svelte",
    "rootDir": "./src/svelte",
    "composite": true,
    "declaration": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/svelte/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
