SMRT_RUNTIME_PROFILE=cloud
DATABASE_URL=postgresql://managed-connection-from-secret-provider
HOST=0.0.0.0
PORT=3000
# Configure installed provider-owned modules that probe the real services.
# SMRT_AUTH_READINESS_MODULE=@your-org/auth-readiness
