{
  "name": "@happyvertical/smrt-dev-mcp",
  "version": "0.55.6",
  "description": "Development MCP server for SMRT framework knowledge, review context, architecture context, and code generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "smrt-dev-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js"
    },
    "./dev-plane": {
      "types": "./dist/dev-plane.d.ts",
      "import": "./dist/dev-plane.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./schemas/agent-plugins-1.0.0/plugin.schema.json": "./schemas/agent-plugins-1.0.0/plugin.schema.json",
    "./schemas/agent-plugins-1.0.0/mcp.schema.json": "./schemas/agent-plugins-1.0.0/mcp.schema.json"
  },
  "files": [
    "CLAUDE.md",
    "README.md",
    "dist",
    "AGENTS.md",
    "plugin.json",
    "mcp.json",
    "skills",
    "schemas"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/smrt-dev-mcp"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/smrt/issues"
  },
  "homepage": "https://github.com/happyvertical/smrt/tree/main/packages/smrt-dev-mcp#readme",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "clean": "rm -rf dist",
    "dev": "npm run build:watch & npm run test:watch",
    "prepack": "node ../../scripts/prepack-package.js",
    "verify:pack": "node ../../scripts/verify-package-types-exports.js . && node scripts/verify-build-artifacts.mjs"
  },
  "dependencies": {
    "@happyvertical/smrt-scanner": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@happyvertical/smrt-types": "workspace:*"
  },
  "devDependencies": {
    "@happyvertical/smrt-config": "workspace:*",
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/sql": "catalog:",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@types/node": "24.13.6",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "author": "HappyVertical",
  "engines": {
    "node": ">=26.0.0"
  }
}
