{
  "name": "@happyvertical/smrt-commerce",
  "version": "0.19.12",
  "description": "Commerce models for the SMRT framework - contracts, fulfillments, payments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./dist/manifest.json",
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run generate:test && tsc && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json && cp src/manifest/test-manifest.json dist/manifest.json",
    "dev": "tsc --watch",
    "generate:test": "node scripts/generate-test-manifest.js",
    "test": "pnpm run generate:test && npx vitest run",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "smrt",
    "commerce",
    "contracts",
    "fulfillment",
    "payments",
    "ledger",
    "accounting"
  ],
  "author": "HappyVertical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/smrt.git",
    "directory": "packages/commerce"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "@happyvertical/smrt-core": "workspace:*",
    "@happyvertical/smrt-types": "workspace:*"
  },
  "peerDependencies": {
    "@happyvertical/smrt-ledgers": "workspace:*",
    "@happyvertical/smrt-profiles": "workspace:*",
    "@happyvertical/smrt-svelte": "workspace:*",
    "svelte": "^5.18.0"
  },
  "peerDependenciesMeta": {
    "@happyvertical/smrt-svelte": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happyvertical/smrt-ledgers": "workspace:*",
    "@happyvertical/smrt-svelte": "workspace:*",
    "@happyvertical/smrt-vitest": "workspace:*",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "fast-glob": "^3.3.2",
    "svelte": "^5.18.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.8"
  }
}
